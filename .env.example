# Kopiere diese Datei zu ".env" und trage echte Werte ein.
# ".env" ist in .gitignore und landet NIE im Repository.

# --- Datenbank ---------------------------------------------------------
# Passwort fuer den Postgres-Container aus docker-compose.yml
POSTGRES_PASSWORD=dels_dev_passwort

# Verbindungsstring, den die API benutzt.
# Aufbau: postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=postgres://dels:dels_dev_passwort@localhost:5432/dels

# Nur fuer den einmaligen Import aus dem Altsystem gebraucht.
# Zu finden im Supabase-Dashboard unter Connect, Variante "URI".
# Enthaelt ein Passwort: gehoert nur hierher, nie in einen Commit.
# SUPABASE_DATABASE_URL=postgresql://postgres:PASSWORT@db.xxx.supabase.co:5432/postgres

# Eigene Datenbank fuer die Tests. Sie legen Daten an und loeschen sie
# wieder, das gehoert nicht in die Entwicklungsdatenbank und schon gar
# nicht in die produktive. Anlegen mit:
#   createdb dels_test && npm run db:migrate -w @dels/api
# (fuer die Migration vorher DATABASE_URL auf dels_test zeigen lassen)
TEST_DATABASE_URL=postgres://dels:dels_dev_passwort@localhost:5432/dels_test

# --- API ---------------------------------------------------------------
PORT=3000
NODE_ENV=development

# Schluessel, mit dem Session-Cookies signiert werden.
# MUSS in Produktion zufaellig und geheim sein. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=nur-fuer-lokale-entwicklung-bitte-ersetzen

# Woher darf der Browser die API aufrufen (CORS).
WEB_ORIGIN=http://localhost:5173

# Anzahl Proxys vor der API (nginx, Caddy, Load Balancer).
# 0 = kein Proxy, so wie bei lokaler Entwicklung.
TRUST_PROXY=0

# --- Web ---------------------------------------------------------------
# Alles mit VITE_ Praefix landet im Browser-Bundle. Also NIEMALS
# Passwoerter oder Schluessel mit VITE_ benennen.
VITE_API_URL=http://localhost:3000
