# Vorlage fuer den Produktivbetrieb.
# Kopieren nach .env auf dem Server und ausfuellen.
# Diese Datei gehoert NICHT ins Repository.

# Passwort der Datenbank. Erzeugen mit:
#   openssl rand -base64 24
POSTGRES_PASSWORD=

# Schluessel, mit dem Sitzungs-Cookies signiert werden.
# Mindestens 32 Zeichen. Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wird dieser Wert geaendert, sind alle angemeldeten Benutzer abgemeldet.
SESSION_SECRET=

# Die oeffentliche Adresse der Anwendung, MIT https.
# Ueber reines http funktioniert die Anmeldung nicht: das Cookie ist
# "secure" und wird dann nie zurueckgeschickt.
WEB_ORIGIN=https://stunden.deine-firma.ch

# Anzahl Zwischenstationen vor der Anwendung.
# Hinter genau einem Reverse Proxy: 1.
TRUST_PROXY=1

# Wie lange Sicherungen aufbewahrt werden und wann gesichert wird.
BACKUP_BEHALTEN_TAGE=30
BACKUP_STUNDE=2
